# NVIDIA Build / NGC API key for the hosted 3D Body Pose NIM (NVCF).
# Get one at https://build.nvidia.com/nvidia/body-pose -> "Get API Key"
NVIDIA_API_KEY=nvapi-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hosted NVCF endpoint. Leave as-is unless you self-host the NIM container,
# in which case set SNOW_NIM_TARGET=127.0.0.1:8001 and SNOW_NIM_PREVIEW=0
SNOW_NIM_TARGET=grpc.nvcf.nvidia.com:443
SNOW_NIM_FUNCTION_ID=254b3621-bb66-4b7b-9c89-621c352b4d91
SNOW_NIM_PREVIEW=1
